[zh-cn]
name = "MCP 智能助手网关"
auth = "shh"
descript = "对外提供一个 Model Context Protocol 服务端，让支持 MCP 的 AI 客户端（Claude、Cursor 或任何其它 MCP 客户端）能操作你的 TNAS。工具分四组：文件（list_directory、search_files、get_file_info、read_text_file）、存储（get_volume_usage、get_folder_size、get_large_files）、媒体（get_media_metadata、extract_audio）、任务（create_job、get_job、cancel_job）。访问由你维护的目录白名单与三级权限控制——只读（默认）、可写、危险。**不提供任何形式的 shell 执行工具**：每个操作都是固定命名的具体能力。每次调用都会解析路径并与白名单比对，目录穿越与逃出允许范围的软链接都会被拒绝。所有工具调用都写入审计日志，可在网页界面查看，界面同时给出可直接粘贴到 AI 客户端的配置片段。服务端以 JSON-RPC 2.0 同时支持 stdio 与 HTTP 两种传输。"
release_note = "1. 首次发布。"
important = "默认权限为只读，且目录白名单初始为空。连接 AI 客户端前请先显式添加可访问目录。"

[zh-hk]
name = "MCP 智能助理閘道"
auth = "shh"
descript = "對外提供一個 Model Context Protocol 伺服端，讓支援 MCP 的 AI 客戶端（Claude、Cursor 或任何其它 MCP 客戶端）能操作你的 TNAS。工具分四組：檔案、儲存、媒體、任務。存取由你維護的目錄白名單與三級權限控制——唯讀（預設）、可寫、危險。**不提供任何形式的 shell 執行工具**：每個操作都是固定命名的具體能力。每次呼叫都會解析路徑並與白名單比對，目錄穿越與逃出允許範圍的軟連結都會被拒絕。所有工具呼叫都寫入稽核日誌，可在網頁介面查看，介面同時給出可直接貼到 AI 客戶端的設定片段。伺服端以 JSON-RPC 2.0 同時支援 stdio 與 HTTP 兩種傳輸。"
release_note = "1. 首次發佈。"
important = "預設權限為唯讀，且目錄白名單初始為空。連接 AI 客戶端前請先明確加入可存取目錄。"

[en-us]
name = "MCP Hub"
auth = "shh"
descript = "Runs a Model Context Protocol server for MCP-capable AI clients working with your TNAS. Tools cover files, storage, media and jobs. Access is limited by a directory whitelist and three permission levels: read-only (the default), read-write and dangerous. There is no shell execution tool of any kind. Every path is resolved and checked against the whitelist, so traversal and escaping symlinks are refused. All calls go to an audit log, alongside a client configuration snippet to copy."
release_note = "1. Initial release."
important = "Default permission level is Read-only, and the directory whitelist starts empty. Add directories explicitly before connecting an AI client."

[fr-fr]
name = "Passerelle MCP"
auth = "shh"
descript = "Serveur Model Context Protocol : les clients IA compatibles MCP (Claude, Cursor...) pilotent votre TNAS via des outils de fichiers, stockage, médias et tâches. Une liste blanche de dossiers et trois niveaux de droits — lecture seule (défaut), écriture, dangereux — contrôlent l'accès. Aucun outil d'exécution de commandes : chaque opération est une capacité figée, chaque appel vérifie le chemin contre la liste blanche, et tout est journalisé dans l'interface. JSON-RPC 2.0 en stdio et HTTP."
release_note = "1. Première version."
important = "Lecture seule par défaut, et la liste blanche de dossiers est vide au départ. Ajoutez explicitement les dossiers accessibles avant de connecter un client IA."

[de-de]
name = "MCP-Gateway"
auth = "shh"
descript = "Model-Context-Protocol-Server: MCP-fähige KI-Clients (Claude, Cursor...) steuern Ihr TNAS über Werkzeuge für Dateien, Speicher, Medien und Aufgaben. Eine Ordner-Whitelist und drei Rechte-Stufen — nur lesen (Standard), schreiben, gefährlich — regeln den Zugriff. Kein Werkzeug zur Befehlsausführung: jede Operation ist eine feste Fähigkeit, jeder Aufruf prüft den Pfad gegen die Whitelist, und alles wird in der Oberfläche protokolliert. JSON-RPC 2.0 über stdio und HTTP."
release_note = "1. Erstveröffentlichung."
important = "Standardmäßig nur lesen, und die Ordner-Whitelist ist zunächst leer. Fügen Sie zugängliche Ordner ausdrücklich hinzu, bevor Sie einen KI-Client verbinden."

[it-it]
name = "Gateway MCP"
auth = "shh"
descript = "Server Model Context Protocol: i client IA compatibili MCP (Claude, Cursor...) pilotano il TNAS con strumenti per file, archiviazione, media e attività. L'accesso è regolato da una lista bianca di cartelle e da tre livelli di diritti: sola lettura (predefinito), scrittura, pericoloso. Nessuno strumento di esecuzione comandi: ogni operazione è una capacità fissa, ogni chiamata verifica il percorso rispetto alla lista bianca e tutto è registrato nell'interfaccia. JSON-RPC 2.0 su stdio e HTTP."
release_note = "1. Prima versione."
important = "Sola lettura per impostazione predefinita e lista bianca delle cartelle inizialmente vuota. Aggiungi esplicitamente le cartelle accessibili prima di collegare un client IA."

[es-es]
name = "Pasarela MCP"
auth = "shh"
descript = "Servidor Model Context Protocol: los clientes de IA compatibles con MCP (Claude, Cursor...) manejan tu TNAS con herramientas de archivos, almacenamiento, medios y tareas. El acceso lo regulan una lista blanca de carpetas y tres niveles de permisos: solo lectura (por defecto), escritura y peligroso. Sin herramienta de ejecución de comandos: cada operación es una capacidad fija, cada llamada comprueba la ruta contra la lista blanca y todo queda registrado en la interfaz. JSON-RPC 2.0 por stdio y HTTP."
release_note = "1. Primera versión."
important = "Solo lectura por defecto y lista blanca de carpetas inicialmente vacía. Añade explícitamente las carpetas accesibles antes de conectar un cliente de IA."

[hu-hu]
name = "MCP átjáró"
auth = "shh"
descript = "Model Context Protocol szerver: az MCP-kompatibilis AI kliensek (Claude, Cursor...) fájl-, tárhely-, média- és feladateszközökkel vezérlik a TNAS-t. A hozzáférést mappák fehérlistája és három jogosultsági szint szabályozza: csak olvasás (alapértelmezett), írás, veszélyes. Parancsfuttató eszköz nincs: minden művelet rögzített képesség, minden hívás ellenőrzi az útvonalat a fehérlistán, és minden naplózva van a felületen. JSON-RPC 2.0 stdio és HTTP fölött."
release_note = "1. Első kiadás."
important = "Alapértelmezésben csak olvasás, és a mappák fehérlistája kezdetben üres. Az AI kliens csatlakoztatása előtt vegye fel kifejezetten a hozzáférhető mappákat."

[ja-jp]
name = "MCP ゲートウェイ"
auth = "shh"
descript = "Model Context Protocol サーバーです。MCP 対応の AI クライアント（Claude、Cursor など）がファイル・ストレージ・メディア・タスクの各ツールで TNAS を操作できます。アクセスはフォルダーの許可リストと 3 段階の権限（既定は読み取り専用、書き込み可、危険）で制御します。コマンド実行ツールは一切なく、各操作は固定名の機能で、呼び出しごとにパスを許可リストと照合し、すべて監査ログに記録されます。stdio と HTTP の両方で JSON-RPC 2.0 に対応します。"
release_note = "1. 初回リリース。"
important = "既定の権限は読み取り専用で、フォルダーの許可リストは最初は空です。AI クライアントを接続する前に、アクセスを許可するフォルダーを明示的に追加してください。"

[ko-kr]
name = "MCP 게이트웨이"
auth = "shh"
descript = "Model Context Protocol 서버입니다. MCP를 지원하는 AI 클라이언트(Claude, Cursor 등)가 파일·저장소·미디어·작업 도구로 TNAS를 다룹니다. 접근은 폴더 허용 목록과 3단계 권한(기본 읽기 전용, 쓰기 가능, 위험)으로 통제합니다. 명령 실행 도구는 없으며, 모든 작업은 고정된 기능이고 호출마다 경로를 허용 목록과 대조하며, 전부 감사 로그에 기록됩니다. stdio와 HTTP 양쪽에서 JSON-RPC 2.0을 지원합니다."
release_note = "1. 최초 릴리스."
important = "기본 권한은 읽기 전용이며 폴더 허용 목록은 처음에는 비어 있습니다. AI 클라이언트를 연결하기 전에 접근할 폴더를 직접 추가하세요."

[pl-pl]
name = "Brama MCP"
auth = "shh"
descript = "Serwer Model Context Protocol: klienty AI zgodne z MCP (Claude, Cursor...) sterują TNAS przez narzędzia do plików, pamięci, multimediów i zadań. Dostęp reguluje biała lista folderów oraz trzy poziomy uprawnień: tylko odczyt (domyślnie), zapis, niebezpieczny. Bez narzędzia do wykonywania poleceń: każda operacja to stała zdolność, każde wywołanie sprawdza ścieżkę wobec białej listy, a wszystko trafia do dziennika w interfejsie. JSON-RPC 2.0 przez stdio i HTTP."
release_note = "1. Pierwsze wydanie."
important = "Domyślnie tylko odczyt, a biała lista folderów jest początkowo pusta. Przed podłączeniem klienta AI dodaj jawnie dostępne foldery."

[ru-ru]
name = "Шлюз MCP"
auth = "shh"
descript = "Сервер Model Context Protocol: ИИ-клиенты с поддержкой MCP (Claude, Cursor и другие) управляют TNAS через инструменты для файлов, хранилища, медиа и задач. Доступ регулируют белый список папок и три уровня прав: только чтение (по умолчанию), запись, опасный. Инструмента выполнения команд нет: каждая операция — фиксированная возможность, каждый вызов сверяет путь с белым списком, и всё пишется в журнал в интерфейсе. JSON-RPC 2.0 через stdio и HTTP."
release_note = "1. Первый выпуск."
important = "По умолчанию только чтение, а белый список папок изначально пуст. Перед подключением ИИ-клиента явно добавьте доступные папки."

[tr-tr]
name = "MCP ağ geçidi"
auth = "shh"
descript = "Model Context Protocol sunucusu: MCP destekli yapay zekâ istemcileri (Claude, Cursor...) dosya, depolama, medya ve görev araçlarıyla TNAS cihazınızı yönetir. Erişimi bir klasör izin listesi ve üç yetki düzeyi denetler: salt okunur (varsayılan), yazılabilir, tehlikeli. Komut çalıştırma aracı yoktur: her işlem sabit bir yetenek, her çağrı yolu izin listesiyle karşılaştırır ve hepsi arayüzde günlüğe yazılır. stdio ve HTTP üzerinden JSON-RPC 2.0."
release_note = "1. İlk sürüm."
important = "Varsayılan yetki salt okunurdur ve klasör izin listesi başlangıçta boştur. Bir yapay zekâ istemcisi bağlamadan önce erişilecek klasörleri açıkça ekleyin."

[pt-pt]
name = "Gateway MCP"
auth = "shh"
descript = "Servidor Model Context Protocol: os clientes de IA compatíveis com MCP (Claude, Cursor...) controlam o seu TNAS com ferramentas de ficheiros, armazenamento, multimédia e tarefas. O acesso é regulado por uma lista branca de pastas e três níveis de permissões: só leitura (predefinição), escrita, perigoso. Sem ferramenta de execução de comandos: cada operação é uma capacidade fixa, cada chamada verifica o caminho contra a lista branca e tudo fica registado na interface. JSON-RPC 2.0 em stdio e HTTP."
release_note = "1. Primeira edição."
important = "Só leitura por predefinição e lista branca de pastas inicialmente vazia. Adicione explicitamente as pastas acessíveis antes de ligar um cliente de IA."
